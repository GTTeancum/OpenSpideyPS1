# Disc images (700MB+ each, never commit)
*.bin
*.img
*.sub
*.ccd
*.chd

# .NET build output
bin/
obj/
dist/
publish/

# Generated recompiler output
spiderman/port/generated/
spiderman2/port/generated/
generated/

# Runtime artifacts
*.log
shots/
logs/
*.sav

# Extracted disc data
spiderman/extracted/
spiderman2/extracted/

# Published single-file build
spiderman/port/dist/
spiderman2/port/dist/
# Capture output
spiderman/port/**/shots*/
spiderman2/port/**/shots*/
run*.txt

# Disc cue sheets -- part of a disc dump; supply your own
*.cue

# Python bytecode
__pycache__/
*.pyc
